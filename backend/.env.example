# USDA FoodData Central API key
# Get a free key at https://fdc.nal.usda.gov/api-guide.html
# Without a key the DEMO_KEY rate limit applies (30 req/hour per IP)
USDA_FDC_API_KEY=your_key_here

# JWT signing secret (change in production)
JWT_SECRET=ketotap-secret-key-change-in-production

# Port for the Express server
PORT=3001
